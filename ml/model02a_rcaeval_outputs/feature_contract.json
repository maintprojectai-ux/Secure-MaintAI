{
  "model": "Model 02-A Technical Failure Specialist",
  "target": "fault",
  "classes": [
    "cpu",
    "delay",
    "disk",
    "loss",
    "mem"
  ],
  "feature_columns": [
    "cpu_utilization__mean",
    "cpu_utilization__std",
    "cpu_utilization__min",
    "cpu_utilization__max",
    "cpu_utilization__p95",
    "cpu_utilization__last",
    "cpu_utilization__slope",
    "memory_utilization__mean",
    "memory_utilization__std",
    "memory_utilization__min",
    "memory_utilization__max",
    "memory_utilization__p95",
    "memory_utilization__last",
    "memory_utilization__slope",
    "request_latency__mean",
    "request_latency__std",
    "request_latency__min",
    "request_latency__max",
    "request_latency__p95",
    "request_latency__last",
    "request_latency__slope",
    "error_rate__mean",
    "error_rate__std",
    "error_rate__min",
    "error_rate__max",
    "error_rate__p95",
    "error_rate__last",
    "error_rate__slope",
    "telemetry_global__mean",
    "telemetry_global__std",
    "telemetry_global__min",
    "telemetry_global__max",
    "telemetry_global__p95"
  ],
  "window_size": 30,
  "stride": 10,
  "deployment_signal_source": "OpenTelemetry-compatible canonical telemetry",
  "excluded_metadata": [
    "case_id",
    "root_cause_service",
    "window_end_time"
  ]
}