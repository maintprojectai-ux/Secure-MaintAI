# =============================================================================
# Secure-MaintAI — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env files with real credentials.
# =============================================================================

# ---------- General ----------
APP_NAME=Secure-MaintAI
APP_ENV=development
# Options: development, test, production
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
APP_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
APP_CORS_ORIGINS=http://localhost:3000

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_RATE_LIMIT=100/minute
API_MAX_PAYLOAD_SIZE_MB=10

# ---------- Database (PostgreSQL) ----------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=secure_maintai
DATABASE_USER=secure_maintai
DATABASE_PASSWORD=change-me
DATABASE_ECHO=false
# Full URL constructed from above, or override directly:
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# ---------- Database (Test) ----------
TEST_DATABASE_NAME=secure_maintai_test

# ---------- Authentication ----------
AUTH_JWT_SECRET_KEY=change-me-to-a-random-jwt-secret-key
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15

# ---------- University IdP (Phase 4) ----------
# IDP_ENABLED=false
# IDP_PROTOCOL=oidc
# Options: oidc, saml, ldap
# IDP_ISSUER_URL=
# IDP_CLIENT_ID=
# IDP_CLIENT_SECRET=
# IDP_REDIRECT_URI=
# IDP_SCOPES=openid profile email
# IDP_CACHE_TTL_SECONDS=300

# ---------- Agent Communication ----------
# AGENT_AUTH_METHOD=api_key
# AGENT_HEARTBEAT_INTERVAL_SECONDS=60
# AGENT_TELEMETRY_BATCH_SIZE=100
# AGENT_MAX_PAYLOAD_SIZE_KB=512

# ---------- ML Engine (Phase 3+) ----------
# ML_MODEL_DIRECTORY=ml/models/artifacts
# ML_INFERENCE_TIMEOUT_SECONDS=5
# ML_ANOMALY_THRESHOLD=0.5
# ML_CLASSIFICATION_THRESHOLD=0.6
# ML_MODEL_VERSION=baseline-1.0

# ---------- SIEM / XDR (Phase 4+) ----------
# SIEM_ENABLED=false
# SIEM_ENDPOINT_URL=
# SIEM_API_KEY=
# SIEM_TRANSPORT=https
# XDR_ENABLED=false
# XDR_ENDPOINT_URL=
# XDR_API_KEY=

# ---------- SOAR (Phase 5+) ----------
# SOAR_ENABLED=false
# SOAR_MAX_ACTIONS_PER_MINUTE=10
# SOAR_REQUIRE_HUMAN_APPROVAL=true
# SOAR_EMERGENCY_KILL_SWITCH=true

# ---------- Telemetry Storage ----------
# TIMESCALE_ENABLED=false
# TIMESCALE_HOST=localhost
# TIMESCALE_PORT=5432
# TIMESCALE_DATABASE=secure_maintai_ts

# ---------- Redis (Optional Cache) ----------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ---------- Monitoring / Observability ----------
# PROMETHEUS_ENABLED=false
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001

# ---------- Frontend (Phase 2+) ----------
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
